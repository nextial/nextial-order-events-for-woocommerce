{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nextial/order-events",
  "title": "Nextial Order Events for WooCommerce",
  "description": "WooCommerce orders, sales and low stock in ChatGPT and Claude. Free WordPress plugin, OAuth sign-in.",
  "version": "1.0.11",
  "websiteUrl": "https://wordpress.org/plugins/nextial-order-events-for-woocommerce/",
  "repository": {
    "url": "https://github.com/nextial/nextial-order-events-for-woocommerce",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://ps.w.org/nextial-order-events-for-woocommerce/assets/icon-256x256.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{site}/wp-json/nextial-order-events/v1/mcp",
      "variables": {
        "site": {
          "description": "Your store's domain, with the WordPress folder if any (install the free plugin first). Sign-in is OAuth, no keys.",
          "placeholder": "shop.example.com",
          "isRequired": true
        }
      }
    }
  ]
}
